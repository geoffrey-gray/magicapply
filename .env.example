# Copy to .env and fill in. Loaded by config layer when present.

# Anthropic API key for LLM operations (Phase 5+).
ANTHROPIC_API_KEY=

# Opt-in to network-hitting integration tests. Unset or "0" skips them.
# WARNING: some marked "linkedin" scrape LinkedIn which violates their ToS.
# Set MAGICAPPLY_LIVE_TESTS=1 to run integration tests except the linkedin marker.
# Set MAGICAPPLY_LINKEDIN_TESTS=1 to additionally run the linkedin-marked tests.
MAGICAPPLY_LIVE_TESTS=0
MAGICAPPLY_LINKEDIN_TESTS=0

# Optional LinkedIn session cookie for authenticated scraping (Phase 6+, opt-in).
# LINKEDIN_LI_AT=
