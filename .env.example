# Copy to .env and fill in. Loaded by the config layer when present.

# Anthropic API key for LLM operations (unnecessary with provider: mock/replay).
ANTHROPIC_API_KEY=

# Opt-in to network-hitting integration tests.
# WARNING: some marked "linkedin" scrape LinkedIn which violates their ToS.
MAGICAPPLY_LIVE_TESTS=0
MAGICAPPLY_LINKEDIN_TESTS=0

# Live-apply E2E gate. Enables tests/integration/e2e/test_e2e_live.py, which
# runs `magicapply run --no-submit --headless` against real configured
# sources. --yes-submit is never wired into that test.
MAGICAPPLY_LIVE_APPLY=0
# Required when MAGICAPPLY_LIVE_APPLY=1: which profile to run.
MAGICAPPLY_LIVE_APPLY_PROFILE=
# Optional: --root override for the live test (defaults to standard lookup).
MAGICAPPLY_LIVE_APPLY_ROOT=

# Set to 1 to have provider: replay capture new LLM responses into
# configs/llm-fixtures/<key>.yaml when it does not find a fixture.
MAGICAPPLY_LLM_RECORD=0

# Set to 1 to rewrite tests/goldens/tailoring/* from the current run.
MAGICAPPLY_UPDATE_GOLDENS=0

# LinkedIn scraping (authenticated, ToS-sensitive).
# Required: MAGICAPPLY_LINKEDIN_ACK=1 (ToS risk acknowledgement).
# Auth (any one path is enough — preferred first):
#   1) magicapply auth login linkedin  → data/auth/linkedin_storage_state.json
#   2) LINKEDIN_SESSION_COOKIES=<full Cookie header from linkedin.com>
#   3) LINKEDIN_LI_AT=<li_at only — weaker fallback>
# Never paste cookie values into chat or commit them.
MAGICAPPLY_LINKEDIN_ACK=0
LINKEDIN_SESSION_COOKIES=
LINKEDIN_LI_AT=

# Indeed scraping (ToS-sensitive). MAGICAPPLY_INDEED_ACK must be 1 for the
# adapter to make requests. Cloudflare blocks anonymous headless Chromium,
# so INDEED_SESSION_COOKIES (semicolon-separated `name=value` pairs from
# your browser's Cookie header for a logged-in indeed.com session) is the
# path that actually works. When set, the proxy pool is bypassed for this
# source (auth sessions and per-proxy contexts don't mix). See runbook §13
# for the DevTools extraction workflow.
MAGICAPPLY_INDEED_ACK=0
INDEED_SESSION_COOKIES=

# Glassdoor scraping (ToS-sensitive). MAGICAPPLY_GLASSDOOR_ACK must be 1.
# Two cookie env vars, either or both may be set:
#   GLASSDOOR_SESSION         -- legacy single-cookie path; sets `gdSession`.
#   GLASSDOOR_SESSION_COOKIES -- new multi-cookie path; browser Cookie header
#                                string. Both fire when set (combined list).
# When either is set, the proxy pool is bypassed for this source. See
# runbook §13 for the DevTools extraction workflow.
MAGICAPPLY_GLASSDOOR_ACK=0
GLASSDOOR_SESSION=
GLASSDOOR_SESSION_COOKIES=
